{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your_Database_ConnectionString"
  },

  "ApiSetting": {
    "JwtOptions": {
      "Secret": "Your_API_Secret_Key",
      "Issuer": "mango-auth-api",
      "Audience": "mango-client"
    }
  }
  
}
