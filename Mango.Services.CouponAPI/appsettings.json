{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your_DatabaseConnection_String"
  },
  "ApiSetting": {
    "Secret": "Your_API_KEY",
    "Issuer": "mango-auth-api",
    "Audience": "mango-client"
  },
  "Stripe": {
     "SecretKey"   :"Your_Stripe_Secret_Key"
  }


}
