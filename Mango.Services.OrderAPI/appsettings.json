{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Your_Database_ConnectionString"
  },
  "ApiSetting": {
    "Secret": "Your_API_SECRET_KEY",
    "Issuer": "mango-auth-api",
